<?xml version="1.0" encoding="UTF-8"?>
<!-- For running the suite from a host project that has this module installed as a symlinked path
     repository; see README "Running the tests". failOnWarning is pinned so a PHP warning behaves the
     same on PHPUnit 9 (Silverstripe 5) and PHPUnit 11 (Silverstripe 6). -->
<phpunit bootstrap="vendor/silverstripe/framework/tests/bootstrap.php" colors="true" failOnWarning="true">
    <testsuites>
        <testsuite name="formobfuscator">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
